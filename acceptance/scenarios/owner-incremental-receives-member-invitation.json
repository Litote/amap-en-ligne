{
  "id": "owner-incremental-receives-member-invitation",
  "title": "A member invitation created by an AMAP admin reaches the OWNER as an incremental instance-owner change",
  "targets": [
    "server",
    "flutter"
  ],
  "given": {
    "backendState": "organization org-1",
    "appState": "fresh"
  },
  "when": [
    {
      "actor": "client",
      "action": "sync",
      "as": "owner",
      "save": {
        "cursorRefs": {
          "instance-owner": "ownerInstanceCursor",
          "owner:acceptance-owner": "ownerFeedCursor"
        }
      },
      "request": {
        "cursors": {},
        "mutations": []
      }
    },
    {
      "actor": "client",
      "action": "sync",
      "as": "admin:org-1",
      "request": {
        "cursors": {},
        "mutations": [
          {
            "client_op_id": "op-invite",
            "op": {
              "type": "Upsert",
              "payload": {
                "type": "MemberInvitation",
                "memberInvitation": {
                  "invitation_id": "tmp_member_invitation",
                  "organization_id": "org-1",
                  "email": "alice@example.org",
                  "first_name": "Alice",
                  "last_name": "Martin",
                  "roles": [
                    "VOLUNTEER"
                  ],
                  "status": "PENDING_ACTIVATION",
                  "created_at": "2026-01-01T00:00:00Z",
                  "expires_at": "2026-01-08T00:00:00Z"
                }
              }
            }
          }
        ]
      }
    },
    {
      "actor": "client",
      "action": "sync",
      "as": "owner",
      "request": {
        "cursors": {
          "instance-owner": "$ref:ownerInstanceCursor",
          "owner:acceptance-owner": "$ref:ownerFeedCursor"
        },
        "mutations": []
      }
    }
  ],
  "then": {
    "lastResponse": {
      "statusCode": 200,
      "mutationOutcomes": [],
      "snapshotByEntityType": {},
      "changesByEntityType": {
        "MemberInvitation": 1
      }
    }
  }
}
