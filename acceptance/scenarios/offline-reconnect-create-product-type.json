{
  "id": "offline-reconnect-create-product-type",
  "title": "A product type created offline stays queued until reconnect, then converges to the server id",
  "targets": [
    "server",
    "flutter"
  ],
  "given": {
    "backendState": "empty",
    "appState": "fresh"
  },
  "when": [
    {
      "actor": "client",
      "action": "sync",
      "save": {
        "cursorRefs": {
          "producer-account:producerAccountId": "bootstrapCursor"
        }
      },
      "request": {
        "cursors": {},
        "mutations": []
      }
    },
    {
      "actor": "client",
      "action": "sync",
      "request": {
        "cursors": {
          "producer-account:producerAccountId": "$ref:bootstrapCursor"
        },
        "mutations": [
          {
            "client_op_id": "op-1",
            "op": {
              "type": "Upsert",
              "payload": {
                "type": "ProductType",
                "productType": {
                  "product_type_id": "tmp_entity-1",
                  "producer_account_id": "producerAccountId",
                  "name": "Vegetables",
                  "supported_basket_sizes": [
                    {
                      "name": "small"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ],
  "then": {
    "lastResponse": {
      "statusCode": 200,
      "mutationOutcomes": [
        {
          "clientOpId": "op-1",
          "status": "APPLIED",
          "serverEntityId": {
            "kind": "present-and-not-equal",
            "value": "tmp_entity-1"
          }
        }
      ],
      "changesByEntityType": {
        "ProductType": 1
      }
    }
  }
}
