{
  "id": "member-invitation-sync",
  "title": "A synced member invitation can be created and resent while remaining pending",
  "targets": [
    "server",
    "flutter"
  ],
  "given": {
    "backendState": "organization org-1",
    "appState": "fresh"
  },
  "when": [
    {
      "actor": "client",
      "action": "sync",
      "as": "admin:org-1",
      "save": {
        "cursorRefs": {
          "organization:org-1": "orgCursor",
          "member:acceptance-admin-org-1": "memberFeedCursor"
        },
        "entityIdRefs": {
          "op-create": "invitationId"
        }
      },
      "request": {
        "cursors": {
          "organization:org-1": null
        },
        "mutations": [
          {
            "client_op_id": "op-create",
            "op": {
              "type": "Upsert",
              "payload": {
                "type": "MemberInvitation",
                "memberInvitation": {
                  "invitation_id": "tmp_member_invitation",
                  "organization_id": "org-1",
                  "email": "alice@example.org",
                  "first_name": "Alice",
                  "last_name": "Martin",
                  "roles": [
                    "VOLUNTEER"
                  ],
                  "status": "PENDING_ACTIVATION",
                  "created_at": "2026-01-01T00:00:00Z",
                  "expires_at": "2026-01-08T00:00:00Z"
                }
              }
            }
          }
        ]
      }
    },
    {
      "actor": "client",
      "action": "sync",
      "as": "admin:org-1",
      "request": {
        "cursors": {
          "organization:org-1": "$ref:orgCursor",
          "member:acceptance-admin-org-1": "$ref:memberFeedCursor"
        },
        "mutations": [
          {
            "client_op_id": "op-resend",
            "op": {
              "type": "Upsert",
              "payload": {
                "type": "MemberInvitation",
                "memberInvitation": {
                  "invitation_id": "$ref:invitationId",
                  "organization_id": "org-1",
                  "email": "alice@example.org",
                  "first_name": "Alice",
                  "last_name": "Martin",
                  "roles": [
                    "VOLUNTEER"
                  ],
                  "status": "PENDING_ACTIVATION",
                  "created_at": "2026-01-01T00:00:00Z",
                  "expires_at": "2026-01-08T00:00:00Z",
                  "resend_requested_at": "2026-01-02T00:00:00Z"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "then": {
    "lastResponse": {
      "statusCode": 200,
      "mutationOutcomes": [
        {
          "clientOpId": "op-resend",
          "status": "APPLIED",
          "serverEntityId": {
            "kind": "equals",
            "value": "$ref:invitationId"
          }
        }
      ],
      "containsChanges": [
        {
          "entityType": "MemberInvitation",
          "entityId": "$ref:invitationId",
          "op": "UPSERT"
        }
      ]
    }
  }
}
