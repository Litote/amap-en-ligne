{
  "id": "member-join-request-resubmit-after-rejection",
  "title": "A person can re-submit a member join request after their previous one was rejected (or their invitation was cancelled)",
  "targets": ["organization-flow"],
  "description": "The public endpoint POST /v1/public/member-join-requests must allow re-submission for the same (email, organization_id) pair once the previous request is no longer PENDING (e.g. REJECTED). Only PENDING requests block re-submission; APPROVED or REJECTED ones do not.",
  "given": {
    "backendState": "organization test-org"
  },
  "when": [
    {
      "actor": "requester",
      "action": "submit_member_join_request",
      "request": {
        "organization_id": "test-org",
        "email": "resubmit@example.com",
        "first_name": "Alice",
        "last_name": "Resubmit"
      },
      "save": {
        "requestIdRef": "firstRequestId"
      }
    },
    {
      "actor": "admin",
      "action": "review_member_join_request",
      "params": {
        "requestId": "$ref:firstRequestId",
        "status": "REJECTED"
      }
    },
    {
      "actor": "requester",
      "action": "submit_member_join_request",
      "request": {
        "organization_id": "test-org",
        "email": "resubmit@example.com",
        "first_name": "Alice",
        "last_name": "Resubmit"
      }
    }
  ],
  "then": {
    "lastResponse": {
      "statusCode": 201
    }
  }
}
