# Production environment of a self-hosted instance (read by docker-compose.yml).
#
#   cp .env.example .env
#   ./generate-secrets.sh >> .env     # appends POSTGRES_PASSWORD, GOTRUE_JWT_SECRET, GOTRUE_SERVICE_ROLE_KEY
#   chmod 600 .env                    # then fill in the values below
#
# `.env` holds secrets: never commit or share it. Leave optional variables commented out
# rather than empty (an empty value counts as set).

# --- Instance --------------------------------------------------------------
# Public domain name (no scheme, no trailing slash). Its DNS A/AAAA records must point at
# this host before the first start (Let's Encrypt validation).
DOMAIN=amap.example.org
# Name shown in the app's server picker and in the email sender name.
INSTANCE_NAME=Mon AMAP
# Image version published on ghcr.io/litote (see the GitHub releases). Pin it: `latest`
# would upgrade the instance on any `docker compose pull`.
IMAGE_TAG=latest

# --- Email (SMTP) — used by the back (invitations, alerts…) and GoTrue (password recovery)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# STARTTLS (port 587). Set to false only for a local relay without TLS.
SMTP_TLS=true
SMTP_USERNAME=noreply@amap.example.org
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=noreply@amap.example.org

# --- Optional --------------------------------------------------------------
# Terms of service URL. Unset → <domain>/cgu.html (bundled template; see the compose file
# to override it with your own).
# INSTANCE_TERMS_URL=https://amap.example.org/cgu.html
# End-user guide linked from the help screen.
# INSTANCE_GUIDE_URL=https://litote.github.io/amap-en-ligne/
# Hide the instance from public server listings.
# INSTANCE_VISIBLE=false
# JVM options of the api container (default -Xmx512m, sized for a 2 GB host).
# JAVA_OPTS=-Xmx512m
# Mobile push (FCM): path of a Firebase service-account JSON mounted into the api container.
# FCM_CREDENTIALS_FILE=/run/secrets/fcm.json
# Android / iOS app links (/.well-known/assetlinks.json, apple-app-site-association).
# ANDROID_PACKAGE_NAME=
# ANDROID_CERT_FINGERPRINT=
# IOS_TEAM_ID=
# IOS_BUNDLE_ID=

# --- Secrets (appended by ./generate-secrets.sh) ---------------------------
